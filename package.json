{
  "name": "immortal-realms",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "VITE_E2E=1 npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "lint": "eslint .",
    "qc": "npm run lint && npm run typecheck && npm run design:check && npm run license:check && npm run build && npm test && npm run test:e2e",
    "design": "node tools/export_design.mjs",
    "design:check": "node tools/export_design.mjs --strict",
    "license:check": "node tools/license_scan.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
